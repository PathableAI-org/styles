{
  "name": "@pathable/storybook",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node ../../scripts/component-docs/cli.mjs storybook",
    "storybook": "pnpm generate && storybook dev -p 6006",
    "build-storybook": "pnpm --filter @pathable/storybook-contracts build && pnpm generate && storybook build && node scripts/copy-icons.mjs",
    "build": "pnpm --filter @pathable/storybook-contracts build && pnpm generate && storybook build && node scripts/copy-icons.mjs",
    "test-storybook": "test-storybook"
  },
  "dependencies": {
    "@pathableai/styles": "workspace:*"
  },
  "devDependencies": {
    "@pathable/storybook-contracts": "workspace:*",
    "@pathableai/component-docs": "workspace:*",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/html-vite": "^10.6.7",
    "@storybook/test-runner": "^0.26.0",
    "axe-playwright": "^2.2.2",
    "react": "19.3.1",
    "sass": "^1.108.2",
    "storybook": "^10.6.7"
  }
}
