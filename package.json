{
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check:format": "prettier --check . --cache --cache-location .prettiercache",
    "format": "prettier --write .",
    "docs": "pnpm --filter @pathableai/styles build && pnpm --filter @pathable/storybook storybook",
    "docs:react": "pnpm --filter @pathableai/styles build && pnpm --filter @pathable/storybook-react storybook",
    "build:docs": "pnpm --filter @pathable/storybook build-storybook",
    "build:docs-react": "pnpm --filter @pathableai/styles build && pnpm --filter @pathableai/react build && pnpm --filter @pathable/storybook-react build-storybook",
    "lint:styles": "pnpm -r run lint:styles",
    "lint:js": "eslint . --max-warnings=0 --cache --cache-location .eslintcache",
    "lint:md": "markdownlint . --ignore-path .markdownlintignore",
    "lint:tokens": "node packages/styles/scripts/lint-tokens.mjs",
    "lint": "pnpm lint:js && pnpm lint:styles && pnpm lint:md && pnpm lint:tokens && pnpm check:format",
    "test:storybook": "node scripts/test-storybook.mjs",
    "test:storybook-styles": "node scripts/test-storybook.mjs styles",
    "test:storybook-react": "node scripts/test-storybook.mjs react",
    "test:storybook-react:all": "pnpm --filter @pathable/storybook-contracts build && pnpm --filter @pathableai/styles build && pnpm --filter @pathableai/react build && bash scripts/test-storybook.sh apps/storybook-react 6007",
    "test:storybook-modal-css": "node scripts/test-storybook-modal-css.mjs",
    "test:modal-open-geometry": "node packages/styles/scripts/test-modal-open-geometry.mjs",
    "test:contracts": "pnpm test:storybook-styles",
    "test:contracts:styles": "pnpm test:storybook-styles",
    "test:storybook-react-server": "node scripts/check-react-server-compatibility.mjs",
    "test:storybook-react-server:strict": "node scripts/check-react-server-compatibility.mjs --strict",
    "check:agent-guidance": "node scripts/check-agent-guidance.mjs && node --test scripts/check-agent-guidance.test.mjs scripts/check-agent-guidance-impact.test.mjs",
    "test:tooling": "node --test scripts/claude/no-suppressions-hook.test.mjs \"scripts/tests/*.test.mjs\"",
    "notes:publish": "node scripts/notes.mjs publish",
    "notes:sync": "node scripts/notes.mjs sync",
    "review:record": "node scripts/review.mjs record",
    "review:show": "node scripts/review.mjs show",
    "verify:gate": "node scripts/verify.mjs gate",
    "verify:record": "node scripts/verify.mjs record",
    "verify:render": "node scripts/verify.mjs render",
    "verify:request": "node scripts/verify.mjs request",
    "verify:show": "node scripts/verify.mjs show",
    "visual:record": "node scripts/visual.mjs record",
    "visual:show": "node scripts/visual.mjs show",
    "merge:gate": "node scripts/merge.mjs gate",
    "check:agent-guidance-impact": "node scripts/check-agent-guidance-impact.mjs",
    "test:visual": "node packages/styles/scripts/test-visual.mjs",
    "test:pixels-styles": "node packages/styles/scripts/test-pixels.mjs",
    "test:pixels-styles:update": "node packages/styles/scripts/test-pixels.mjs --update",
    "storybook:coverage": "node packages/styles/scripts/storybook-coverage.mjs",
    "quality-gates": "node packages/styles/scripts/quality-gates.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "test": "pnpm lint && pnpm test:storybook",
    "test:next-consumer": "node scripts/test-next-consumer.mjs",
    "typecheck": "pnpm --filter @pathableai/react typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "markdownlint-cli": "^0.50.0",
    "next": "16.4.6",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serve": "^14.2.8",
    "serve-handler": "6.1.8",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
