{
  "private": true,
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check:format": "prettier --check .",
    "format": "prettier --write .",
    "docs": "pnpm --filter @pathableai/styles build && pnpm --filter @pathable/storybook storybook",
    "docs:react": "pnpm --filter @pathableai/styles build && pnpm --filter @pathable/storybook-react storybook",
    "build:docs": "pnpm --filter @pathable/storybook build-storybook",
    "build:docs-react": "pnpm --filter @pathableai/styles build && pnpm --filter @pathableai/react build && pnpm --filter @pathable/storybook-react build-storybook",
    "lint:styles": "pnpm -r run lint:styles",
    "lint:js": "eslint . --max-warnings=0",
    "lint:md": "markdownlint . --ignore-path .markdownlintignore",
    "lint:tokens": "node packages/styles/scripts/lint-tokens.mjs",
    "lint": "pnpm lint:js && pnpm lint:styles && pnpm lint:md && pnpm lint:tokens && pnpm check:format",
    "test:storybook": "node scripts/test-storybook.mjs",
    "test:storybook-styles": "node scripts/test-storybook.mjs styles",
    "test:storybook-react": "node scripts/test-storybook.mjs react",
    "test:storybook-react:all": "pnpm --filter @pathable/storybook-contracts build && pnpm --filter @pathableai/styles build && pnpm --filter @pathableai/react build && bash scripts/test-storybook.sh apps/storybook-react 6007",
    "test:contracts": "pnpm test:storybook-styles",
    "test:contracts:styles": "pnpm test:storybook-styles",
    "test:storybook-react-server": "node scripts/check-react-server-compatibility.mjs",
    "test:storybook-react-server:strict": "node scripts/check-react-server-compatibility.mjs --strict",
    "test:visual": "node packages/styles/scripts/test-visual.mjs",
    "storybook:coverage": "node packages/styles/scripts/storybook-coverage.mjs",
    "quality-gates": "node packages/styles/scripts/quality-gates.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "test": "pnpm lint && pnpm test:storybook",
    "test:next-consumer": "node scripts/test-next-consumer.mjs",
    "typecheck": "pnpm --filter @pathableai/react typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-storybook": "^10.3.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "markdownlint-cli": "^0.49.0",
    "next": "15.5.22",
    "playwright": "^1.61.1",
    "prettier": "^3.5.0",
    "publint": "^0.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "serve": "^14.2.6",
    "serve-handler": "6.1.7",
    "stylelint": "^16.18.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0"
  }
}
