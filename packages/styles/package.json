{
  "name": "@pathableai/styles",
  "version": "0.0.3-alpha.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/PathableAI-org/styles",
    "directory": "packages/styles"
  },
  "files": [
    "README.md",
    "BRAND_RULES.md",
    "AGENTS.md",
    "dist",
    "img",
    "src",
    "fonts"
  ],
  "exports": {
    ".": "./dist/styles.css",
    "./js": "./dist/pathable.js",
    "./js/init": "./dist/pathable-init.js",
    "./components": "./dist/components.css",
    "./utilities": "./dist/utilities.css",
    "./theme": "./dist/theme-default.css",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-js.mjs && sass --quiet-deps --load-path=node_modules/@uswds/uswds/packages src/index.scss dist/styles.css && sass --quiet-deps --load-path=node_modules/@uswds/uswds/packages src/components.scss dist/components.css && sass --quiet-deps --load-path=node_modules/@uswds/uswds/packages src/utilities.scss dist/utilities.css && sass --quiet-deps --load-path=node_modules/@uswds/uswds/packages src/theme-default.scss dist/theme-default.css && node scripts/copy-icons.mjs && node scripts/copy-fonts.mjs",
    "watch": "sass --watch --quiet-deps --load-path=node_modules/@uswds/uswds/packages src/index.scss:dist/styles.css src/components.scss:dist/components.css src/utilities.scss:dist/utilities.css src/theme-default.scss:dist/theme-default.css",
    "lint:styles": "stylelint 'src/**/*.scss'",
    "lint:tokens": "node scripts/lint-tokens.mjs"
  },
  "dependencies": {
    "@uswds/uswds": "^3.0.0"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.2.10",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/poppins": "^5.2.7",
    "@pathable/storybook-contracts": "workspace:*",
    "esbuild": "^0.28.0",
    "sass": "^1.86.3",
    "typescript": "^7.0.2"
  }
}
