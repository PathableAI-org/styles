{
  "name": "@pathableai/styles",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PathableAI-org/styles",
    "directory": "packages/styles"
  },
  "files": [
    "README.md",
    "BRAND_RULES.md",
    "AGENTS.md",
    "components",
    "dist",
    "img",
    "src",
    "fonts"
  ],
  "exports": {
    ".": "./dist/styles.css",
    "./components": "./dist/components.css",
    "./utilities": "./dist/utilities.css",
    "./theme": "./dist/theme-default.css",
    "./css/*": "./dist/css/*",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "sass --quiet-deps --load-path=node_modules/@uswds/uswds/packages src/index.scss dist/styles.css && sass --quiet-deps --load-path=node_modules/@uswds/uswds/packages src/components.scss dist/components.css && sass --quiet-deps --load-path=node_modules/@uswds/uswds/packages src/utilities.scss dist/utilities.css && sass --quiet-deps --load-path=node_modules/@uswds/uswds/packages src/theme-default.scss dist/theme-default.css && node scripts/build-css-modules.mjs && node scripts/copy-icons.mjs && node scripts/copy-fonts.mjs && node ../../scripts/component-docs/cli.mjs styles && node scripts/component-pages.mjs index",
    "watch": "sass --watch --quiet-deps --load-path=node_modules/@uswds/uswds/packages src/index.scss:dist/styles.css src/components.scss:dist/components.css src/utilities.scss:dist/utilities.css src/theme-default.scss:dist/theme-default.css",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "check:component-pages": "node scripts/check-component-pages.mjs",
    "check:component-pages:executed": "node scripts/check-component-pages.mjs --executed",
    "trace:component-pages": "node scripts/check-component-pages.mjs --executed --trace",
    "test:component-pages": "node --test scripts/check-component-pages.test.mjs",
    "test:css-modules": "node --test scripts/build-css-modules.test.mjs"
  },
  "dependencies": {
    "@uswds/uswds": "3.14.0"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@pathable/storybook-contracts": "workspace:*",
    "@pathableai/component-docs": "workspace:*",
    "postcss": "^8.5.33",
    "postcss-selector-parser": "^7.2.1",
    "sass": "^1.108.2",
    "yaml": "^2.9.1"
  }
}
